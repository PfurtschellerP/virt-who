# Image tag to run (see https://github.com/PfurtschellerP/virt-who/pkgs/container/virt-who).
VIRT_WHO_IMAGE_TAG=latest

# Satellite connection (required).
SATELLITE_ORG=replace-with-satellite-organization
SATELLITE_HOST=satellite.example.com
SATELLITE_PORT=443
SATELLITE_PREFIX=/rhsm

# Satellite user reporting virt-who data (required).
RHSM_USERNAME=replace-with-virt-who-reporter
RHSM_PASSWORD=replace-me

# virt-who settings.
HYPERVISOR_ID=hostname
LIBVIRT_SERVER=qemu+unix:///system
VIRTWHO_INTERVAL_SECONDS=60
VIRTWHO_DEBUG=0
