{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "virt-who chart values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "computeNodeLabel": { "type": "string" },
    "satellite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "prefix": { "type": "string" }
      }
    },
    "rhsm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "usernameKey": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 },
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "virtWho": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hypervisorId": { "enum": ["hostname", "uuid", "hwuuid"] },
        "libvirtServer": { "type": "string", "minLength": 1 },
        "intervalSeconds": { "type": "integer", "minimum": 60 },
        "debug": { "type": "boolean" }
      }
    },
    "libvirtSocketDir": { "type": "string", "pattern": "^/" },
    "extraEnv": { "type": "array" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "updateStrategy": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "podAffinity": { "type": "object" },
    "podAntiAffinity": { "type": "object" },
    "volumes": { "type": "array" },
    "volumeMounts": { "type": "array" }
  }
}
